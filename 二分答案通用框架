1. 确定解的范围：left = 最小可能值, right = 最大可能值
2. 初始化最优解变量
3. 当left <= right时：
    a. 计算中间值mid = (left + right) / 2
    b. 调用check(mid)判断是否可行
    c. 若可行：
        - 更新最优解为mid
        - 调整范围至[mid+1, right]（寻找更大的解）
      若不可行：
        - 调整范围至[left, mid-1]（寻找更小的解）
4. 输出最优解

！这个框架可以应用于各种二分答案问题，如资源分配、最大最小值、分割问题等，只需根据具体问题调整变量定义和 check 函数的实现逻辑！

#include <bits/stdc++.h>
using namespace std;
/*
二分答案算法核心思想:
通过二分搜索可能的解空间，找到满足条件的最优解
适用于求解"最大值最小化"或"最小值最大化"类问题
基本思路：
1. 确定答案的可能范围[left, right]
2. 二分查找中间值mid，检查是否满足条件
3. 根据检查结果调整搜索范围，逐步逼近最优解
*/

// 变量定义（根据具体题目调整）
int n,k;  // n: 数据数量, k: 题目特定参数（如要求的数量、阈值等）
// 示例数组（根据题目需求定义，也可替换为结构体等）
int h[100001],w[100001];  // 存储问题相关数据
// 检查函数：判断当前mid是否为一个可行解
// 核心：根据题目条件编写判断逻辑
bool check(int d){
    int ans=0;  // 记录符合条件的数量或其他指标
    // 根据具体问题实现判断逻辑
    // 示例：计算某种资源能分成多少个大小为d的部分
    for(int i=0;i<n;i++){
        ans+=(h[i]/d)*(w[i]/d);  // 计算每个元素能产生的数量
    }
    // 返回是否满足题目要求（根据实际问题调整判断条件）
    return ans>=k;  // 若满足条件则返回true，否则返回false
}
int main() {
    // 输入数据（根据题目调整输入内容）
    cin>>n>>k;
    for(int i=0;i<n;i++){
        cin>>h[i]>>w[i]; // 读取问题相关数据
    }
    // 二分边界初始化
    int l=1;               // 左边界：可能的最小解
    int r=100000;          // 右边界：可能的最大解（根据题目调整）
    int ans=1;             // 存储最优解
    // 二分搜索主循环
    while(l<=r){
        int mid=(l+r)/2;     // 计算中间值（当前候选解）
        if(check(mid)){      // 检查mid是否为可行解
            ans=mid;        // 若可行，更新最优解
            l=mid+1;        // 尝试更大的解（寻找更优解）
        }else{
            r=mid-1;        // 若不可行，尝试更小的解
        }
    }
    // 输出最优解
    cout<<ans;
    return 0;
}
