最少步数：

题目描述：
在一个 100×100 的地图中，小童现在 (1,1) 位置，可以从当前位置到达 A 点，也可以到达 B 点。给定 A、B 两点的坐标，按照马走日方式，从当前位置移到相邻的8个区域。请你帮忙分别计算 (1,1) 到达两点的最少步数。注意：数据保证可以走到 A、B 两点。

输入格式：
A、B 两点的坐标。

输出格式：
最少步数。

样例：
输入数据 1：
12 16
18 10

输出数据 1：
10
10

代码：
#include <bits/stdc++.h>
using namespace std;
/*
广度优先搜索:从某个位置开始，逐层搜索，把每一层搜索
到的点存起来，枚举所有的点，找周围的点
*/
struct node{
	int x,y,step;
}q[101*101];//front:表示当前枚举到的 q 数组中元素下标
int v[101][101],front,back,bx,by,ex,ey,f1,f2,ans1,ans2;//back:新找到的点 往 q 放 可以放到的下标	
int dis[8][2]={{-2,1},{-1,2},{1,2},{2,1},{2,-1},{1,-2},{-1,-2},{-2,-1}};//方向数组，给出上下左右每个方向x和y的变化
void bfs(){
	q[back++]={1,1,0};//1.把起点放到 q 数组中
	v[1][1]=1;//把起点标记
	while(front<back){
		node t=q[front++];//临时变量 t 暂存要搜索的点，front++，指向下一次要搜索的点
		if(t.x==bx && t.y==by){//找到终点
			ans1=t.step;
            f1=1;
		}
        if(t.x==ex && t.y==ey){//找到终点
			ans2=t.step;
            f2=1;
		}
        if(f1 && f2){
            break;
        }
		for(int i=0;i<8;i++){
			int tx=t.x+dis[i][0],ty=t.y+dis[i][1];
			if(tx>=1 && tx<=100 && ty>=1 && ty<=100 && v[tx][ty]==0){
				v[tx][ty]=1;
				q[back++]={tx,ty,t.step+1};//放到q数组中，等待 后续搜索其周围能到达且没有被搜索过的点 
			}
		}
	}
}
int main() {
	cin>>bx>>by>>ex>>ey;
	bfs();
    cout<<ans1<<endl<<ans2;
	return 0;
}
