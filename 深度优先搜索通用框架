1. 输入数据并初始化（包括定义地图/状态数据结构、目标状态等）
2. 定义递归函数dfs(当前状态):
    a. 判断是否到达目标状态:
        - 若是，标记找到并返回
    b. 遍历所有可能的下一步:
        一、计算新状态
        二、 判断新状态是否合法(在范围内、未访问、符合条件):
            - 标记新状态为已访问
            - 递归调用dfs(新状态)
            - (可选)若已找到目标，提前返回
3. 标记起点为已访问
4. 调用dfs(起点状态)
5. 根据搜索结果输出结论

注意：
!这个框架适用于各种需要深度优先搜索的问题，如迷宫寻路、连通分量查找、排列组合生成等，只需根据具体问题调整变量，条件判断和方向数组dis即可!

#include <bits/stdc++.h>
using namespace std;
/*
深度优先搜索(DFS)核心思想:
从起始点出发，沿着一条路径尽可能深入地探索，
当无法继续前进时，回溯到上一个节点，选择其他路径继续探索
适用于迷宫问题、连通性判断等需要遍历所有可能路径的场景
*/

int n;                  // 地图大小n*n
int a[11][11];          // 存储地图信息，1表示障碍物或已访问，0表示可通行
int flag;               // 标记是否找到终点，1表示找到，0表示未找到
// 方向数组，分别代表四个方向：上、下、左、右
// 每个元素表示(x变化量, y变化量)
int dis[4][2]={
    {-1,0},  // 上：x减1，y不变
    {1,0},   // 下：x加1，y不变
    {0,-1},  // 左：x不变，y减1
    {0,1}    // 右：x不变，y加1
};
// DFS核心函数：从(x,y)位置开始搜索
void dfs(int x,int y){
    // 1. 判断是否到达终点(n,n)
    if(x==n && y==n){
        flag=1;  // 标记找到终点
        return;  // 返回
    }
    // 2. 遍历四个可能的方向
    for(int i=0;i<4;i++){
        // 计算新位置坐标
        int tx=x+dis[i][0];  // 新x坐标
        int ty=y+dis[i][1];  // 新y坐标
        // 3. 判断新位置是否合法：
        // - 在地图范围内(tx, ty都在1~n之间)
        // - 不是障碍物且未被访问(a[tx][ty] != 1)
        if(tx>=1 && tx<=n && ty>=1 && ty<=n && a[tx][ty]!=1){
            a[tx][ty]=1;       // 标记为已访问（防止重复访问和循环）
            dfs(tx,ty);         // 递归搜索新位置
            // 如果已经找到终点，提前返回，减少不必要的搜索
            if(flag==1){
                return;
            }
        }
    }
}
int main() {
    // 读入地图大小
    cin>>n;
    // 读入地图数据
    for(int i=1;i <=n;i++){
        for(int j=1;j<=n;j++){
            cin>>a[i][j];
        }
    }
    // 初始化：标记起点(1,1)为已访问
    a[1][1]=1;
    // 从起点开始DFS搜索
    dfs(1,1);
    // 根据flag判断是否找到路径
    if (flag==1){
        cout<<"YES";
    } else {
        cout << "NO";   // 未找到路径
    }
    return 0;
}
