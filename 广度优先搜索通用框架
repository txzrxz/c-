初始化:
  将起点加入队列
  标记起点为已访问

循环(队列不为空):
  取出队头节点
  如果是目标节点，返回成功
  遍历所有可能的方向:
    计算新节点坐标
    如果新节点合法(在范围内、未访问、可通行):
      标记为已访问
      加入队列

如果循环结束仍未找到目标，返回失败

注意：
！这个框架可以应用于各种网格类的 BFS 问题，只需根据具体需求调整结构、方向数组dis和变量即可 ！

#include <bits/stdc++.h>
using namespace std;
/*
广度优先搜索(BFS)基本思想:
从起始位置开始，逐层向外扩展搜索
将每一层可达的点都记录下来，按照先进先出的顺序处理
适用于寻找最短路径等问题
*/

// 定义一个结构体表示坐标点
struct node{
    int x;  // x坐标
    int y;  // y坐标
}q[101];  // 用数组实现队列，存储待访问的点
int n;                  // 地图大小n*n
int v[11][11];          // 访问标记数组，v[x][y]=1表示已访问
int front, back;        // 队列指针，front指向队头，back指向队尾
char a[11][11];         // 存储地图信息
// 方向数组，分别代表四个方向：上、下、左、右
// 每个元素表示(x变化量, y变化量)
int dis[4][2] = {
    {-1, 0},  // 上：x减1，y不变
    {1, 0},   // 下：x加1，y不变
    {0, -1},  // 左：x不变，y减1
    {0, 1}    // 右：x不变，y加1
};
// BFS核心函数
void bfs(){
    // 1. 初始化队列：将起点(1,1)加入队列
    q[back++]={1,1};
    // 标记起点为已访问
    v[1][1]=1;
    // 2. 队列不为空时，循环处理
    while(front<back){
        // 取出队头元素并将队头指针后移
        node tmp=q[front++];
        // 3. 判断是否到达终点(n,n)
        if(tmp.x==n && tmp.y == n){
            cout<<"YES";  // 找到路径
            return;       // 直接返回
        }
        // 4. 遍历四个方向
        for(int i=0; i<4;i++){
            int tx=tmp.x+dis[i][0];  // 新x坐标
            int ty=tmp.y+dis[i][1];  // 新y坐标
            // 5. 判断新坐标是否合法：
            // - 在地图范围内(tx, ty都在1~n之间)
            // - 未被访问过(v[tx][ty] == 0)
            // - 不是障碍物(a[tx][ty] != '#')
            if(tx>=1 && tx<=n && ty>=1 && ty<=n && v[tx][ty]==0 && a[tx][ty]!='#'){
                // 标记为已访问
                v[tx][ty]=1;
                // 将新坐标加入队列，等待后续处理
                q[back++]={tx, ty};
            }
        }
    }
    // 6. 如果队列为空仍未找到终点，说明无法到达
    cout<<"NO";
}
int main() {
    cin>>n;
    for(int i=1;i<=n;i++)
        for(int j=1;j<=n;j++)
            cin>>a[i][j];
    // 调用BFS函数
    bfs();
    return 0;
}
