寻找小鹿：

题目描述：
一只野生小鹿，困在了一个n*n大小的家园的(n,n)位置，小童从(1,1)位置出发去解救小鹿，请你通过程序帮忙计算是否可以解救成功。如果能，请输出YES，不能请输出NO。小童只能上下左右四个方向移动，要求：使用广搜。

输入格式：
第一行一个整数 n，表示一个 n×n 的方格图。2≤n≤10。 接下来 n 行，每行n个字符，’.‘表示可通行，’#'表示不可通行。

输出格式：
一行，如果能解救成功输出YES，否则输出NO。

样例：
输入数据 1：
7
. # # . . . . 
. # . . . . . 
. . . . # . . 
. . . . . . # 
# # . # . . . 
# # # . # # . 
. # # # . . .

输出数据 1：
YES

代码：
#include <bits/stdc++.h>
using namespace std;
/*
广度优先搜索:从某个位置开始，逐层搜索，把每一层搜索
到的点存起来，枚举所有的点，找周围的点
*/
struct node{
	int x,y;
}q[101*101];//front:表示当前枚举到的 q 数组中元素下标
int n,v[11][11],front,back;//back:新找到的点 往 q 放 可以放到的下标	
char a[11][11];
int dis[4][2]={{-1,0},{1,0},{0,-1},{0,1}};//方向数组，给出上下左右每个方向x和y的变化
void bfs(){
	q[back++]={1,1};//1.把起点放到 q 数组中
	v[1][1]=1;//把起点标记
	while(front<back){
		node t=q[front++];//临时变量 t 暂存要搜索的点，front++，指向下一次要搜索的点
		if(t.x==n && t.y==n){//找到终点 
			cout<<"YES";
			return;
		} 
		for(int i=0;i<4;i++){
			int tx=t.x+dis[i][0],ty=t.y+dis[i][1];
			if(tx>=1 && tx<=n && ty>=1 && ty<=n && v[tx][ty]==0 && a[tx][ty]!='#'){
				v[tx][ty]=1;
				q[back++]={tx,ty};//放到q数组中，等待 后续搜索其周围能到达且没有被搜索过的点 
			}
		} 
	}
	cout<<"NO";
}
int main() {
	cin>>n;
	for(int i=1;i<=n;i++)for(int j=1;j<=n;j++)cin>>a[i][j];
	bfs();
	return 0;
}
